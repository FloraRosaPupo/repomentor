# Contrato planejado; ainda não consumido por uma aplicação.
# Autenticação Google via ADC; não coloque credenciais neste arquivo.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_AI_ENDPOINT_ID=
# Preencher com o identificador exato da variante Gemma 4 implantada.
GEMMA_MODEL_ID=
GITHUB_TOKEN=
TARGET_REPOSITORY=meteor/meteor
ENABLE_ARCHITECTURE_ANALYSIS=true
ENABLE_ISSUE_CLASSIFICATION=true
ENABLE_CONTRIBUTION_GUIDE=true
ENABLE_CACHE=true
ENABLE_ISSUE_FILTERS=false
ENABLE_GENERIC_REPOSITORIES=false
ENABLE_DEBUG_AI=false
