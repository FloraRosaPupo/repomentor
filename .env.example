# Copie para .env na raiz. Autenticação Google via ADC, somente no backend.
# Escolha vertex-ai (ADC) ou google-ai (chave AI Studio).
GEMMA_PROVIDER=vertex-ai
GOOGLE_AI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_AI_ENDPOINT_ID=
# Opcional: dedicatedEndpointDns de um endpoint dedicado, sem https:// ou caminho.
VERTEX_AI_ENDPOINT_HOST=
# Preencher com o identificador exato da variante Gemma 4 implantada.
GEMMA_MODEL_ID=
GITHUB_TOKEN=
REQUEST_TIMEOUT_SECONDS=120
ENABLE_ARCHITECTURE_ANALYSIS=true
ENABLE_ISSUE_CLASSIFICATION=true
ENABLE_CONTRIBUTION_GUIDE=true
ENABLE_CACHE=true
